{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/api/ccavenue-handle",
      "dest": "https://mnboyuyajxghqbbkdqhi.supabase.co/functions/v1/ccavenue_callback"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/homepage.html"
    },
    {
      "src": "^/mobile$",
      "dest": "/mobile.html"
    },
    {
      "src": "^/on-spot$",
      "dest": "/index.html"
    },
    {
      "src": "^/(events|proevents|yatraevents|pro-dance-battle|yatra-entry|payment-test|gv-prakash|privacy-policy|terms-conditions|admin)(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/payment/(.*)$",
      "dest": "/index.html"
    }
  ]
}
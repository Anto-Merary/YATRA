{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/ccavenue-handle",
      "destination": "https://mnboyuyajxghqbbkdqhi.supabase.co/functions/v1/ccavenue_callback"
    },
    {
      "source": "/",
      "destination": "/homepage.html"
    },
    {
      "source": "/homepage",
      "destination": "/homepage.html"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}